"""Type stubs for the `nmo` module, the Python bindings for Nemo."""

from collections.abc import Iterable, Iterator
from typing import Any, final

__version__: str

# Values that cross the boundary: Python builtins where the mapping is
# lossless, small wrapper classes everywhere else. Python equality
# mirrors term identity: `Iri("a") != "a"`.
Value = Any

class NemoError(Exception):
    """The base of every error the engine raises."""

class DiagnosticsError(NemoError):
    """A failure with structured diagnostics."""

    diagnostics: list[Diagnostic]

@final
class Label:
    message: str
    source: str | None
    line: int | None
    column: int | None

@final
class Diagnostic:
    code: str
    severity: str
    message: str
    labels: list[Label]
    notes: list[str]
    hints: list[str]
    rendered: str

@final
class Iri:
    value: str
    def __init__(self, value: str) -> None: ...

@final
class LanguageString:
    text: str
    language: str
    def __init__(self, text: str, language: str) -> None: ...

@final
class Float:
    value: float
    def __init__(self, value: float) -> None: ...

@final
class Null:
    id: int
    def __init__(self, id: int) -> None: ...

@final
class Literal:
    lexical: str
    datatype: str
    def __init__(self, lexical: str, datatype: str) -> None: ...

@final
class Labeled:
    label: str
    value: Any
    def __init__(self, label: str, value: Any) -> None: ...

@final
class Program:
    @staticmethod
    def parse(text: str, name: str = "<program>") -> Program: ...
    @staticmethod
    def parse_file(path: str) -> Program: ...
    @property
    def diagnostics(self) -> list[Diagnostic]: ...
    @property
    def ok(self) -> bool: ...
    @property
    def predicates(self) -> list[tuple[str, int]]: ...
    def __len__(self) -> int: ...

@final
class Cursor(Iterator[tuple[Value, ...]]):
    @property
    def remaining(self) -> int: ...
    def __iter__(self) -> Cursor: ...
    def __next__(self) -> tuple[Value, ...]: ...

@final
class ArrowStream:
    def __arrow_c_stream__(self, requested_schema: object | None = None) -> object: ...
    def __len__(self) -> int: ...

@final
class Engine:
    def __init__(self) -> None: ...
    def import_rows(self, predicate: str, rows: Iterable[Iterable[Value]]) -> None: ...
    def add_resource(self, name: str, content: str | bytes) -> None: ...
    def add_module(self, name: str, text: str) -> None: ...
    def add_module_root(self, name: str, directory: str) -> None: ...
    def set_import_directory(self, directory: str) -> None: ...
    def retain_imports(self) -> None: ...
    def load(self, program: Program) -> None: ...
    def extend(self, program: Program) -> None: ...
    def reload(self, program: Program) -> None: ...
    def check(self, program: Program) -> list[Diagnostic]: ...
    def reason(self) -> None: ...
    def cancel(self) -> None: ...
    def trace(self, facts: str | Iterable[str]) -> dict[str, Any]: ...
    def trace_ascii(self, facts: str | Iterable[str]) -> str: ...
    def tree_for_table(self, query: dict[str, Any]) -> dict[str, Any]: ...
    def table_entries_for_tree_nodes(self, query: dict[str, Any]) -> list[dict[str, Any]]: ...
    def rule(self, id: int) -> dict[str, Any] | None: ...
    def rows(self, predicate: str) -> list[tuple[Value, ...]]: ...
    def cursor(self, predicate: str) -> Cursor: ...
    def count(self, predicate: str) -> int: ...
    def predicates(self) -> list[tuple[str, int, str]]: ...
    def column_types(self, predicate: str) -> list[str] | None: ...
    def export(self, directory: str) -> None: ...
    def arrow_stream(self, predicate: str) -> ArrowStream: ...
    def to_arrow(self, predicate: str) -> Any: ...
    def to_pandas(self, predicate: str) -> Any: ...
    def reports(self) -> list[Diagnostic]: ...
    @property
    def loaded_facts(self) -> int: ...
    @property
    def derived_facts(self) -> int: ...
    @property
    def applications(self) -> int: ...
    @property
    def memory_bytes(self) -> int: ...
    def timings(self) -> dict[str, int]: ...
