% The formats of an import give the types of its columns, which a
% declaration is checked against: an `int` column parses its cells as
% integers, and a row with a cell that does not parse is malformed.

@declare person(name: string, age: int) .
@import person from csv { resource = "sources/people.csv", format = (string, int) } .

adult(?n) :- person(?n, ?a), ?a >= 18 .
