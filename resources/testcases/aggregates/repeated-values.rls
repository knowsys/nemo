% Several matches share the aggregated value:
%   - a bare `?v` takes the value once,
%   - `?v per ?w` takes it once for each value of the witness.

employee(alice, sales) .
employee(bob, sales) .
employee(carol, it) .
skill(alice, java) .
skill(alice, sql) .
skill(bob, sql) .
skill(carol, rust) .
price(apple, 2) .
price(pear, 2) .
price(plum, 3) .

skills(?dept, #count(?s)) :- employee(?e, ?dept), skill(?e, ?s) .
skillsPerEmployee(?dept, #count(?s per ?e)) :- employee(?e, ?dept), skill(?e, ?s) .
prices(#sum(?p)) :- price(?item, ?p) .
pricesPerItem(#sum(?p per ?item)) :- price(?item, ?p) .
