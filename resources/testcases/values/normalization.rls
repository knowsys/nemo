% Constants written in the program meet the same values read from CSV.

@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

@import b from csv { resource = "sources/b.csv" }.

a(<Some%20Constant%20With%20Spaces>).
a(<AnotherConstant>).
a(YetAnotherConstant).
a("A string with white spaces, which keeps its quotes in the CSV file").
a("String Litral").
a("Another String Literal"^^xsd:string).
a("").
a(12345).
a("6789"^^xsd:integer).

c(?X) :- a(?X), b(?X).
