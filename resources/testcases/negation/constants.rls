% Regression test for https://github.com/knowsys/nemo/issues/452:
% negated atoms with constants, for which an incorrect plan used to
% crash.

S(a, b, c).
S(r, r, r).
T(a, b).
T(a, c).

R(?x, ?y, ?z) :-
    S(?x, ?y, ?z),
    ~ T(?x, ?y),
    ~ T(a, ?z).

R(?x, ?y, ?z) :-
    S(?x, ?y, ?z),
    ~ T(a, ?y),
    ~ T(a, ?z).
