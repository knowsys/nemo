% Decimals and integers beyond 64 bits read from RDF are numbers:
% isNumeric holds for them, and arithmetic on them is exact.
%
% Old Nemo does not treat the decimal and the large integer as numbers,
% so only the `int` facts hold.

@import triples :- ntriples { resource = "sources/numbers.nt" } .

numeric(?p) :- triples(_, ?p, ?o), isNumeric(?o) .
next(?p, ?o + 1) :- triples(_, ?p, ?o) .
