% An integer literal too large for 64 bits is still an integer.
%
% Old Nemo reads such a literal as the nearest double, so the `integer`
% facts are missing:
%   kind("9223372036854776000"^^xsd:double, xsd:double) .
%   kind("-9223372036854776000"^^xsd:double, xsd:double) .
%   kind("18446744073709552000"^^xsd:double, xsd:double) .

n(9223372036854775808) .
n(-9223372036854775809) .
n(18446744073709551616) .

kind(?x, ?t) :- n(?x), ?t = DATATYPE(?x) .
integer(?x) :- n(?x), isInteger(?x) .
