% Decimal literals are exact:
%   - trailing zeros vanish,
%   - integral decimals are integers,
%   - sums carry no rounding error.
%
% Old Nemo reads decimal literals as doubles, so neither `integral` nor
% `exactSum` derives a fact:
%   d("1.5"^^xsd:double) .
%   d("-0.5"^^xsd:double) .
%   d("1"^^xsd:double) .
%   d("0.30000000000000004"^^xsd:double) .
%   d("12345678901234567000"^^xsd:double) .

d(1.5) .
d(1.50) .
d(-0.5) .
d(1.0) .
d(0.1 + 0.2) .
d(12345678901234567890.123456789) .

integral(?x) :- d(?x), ?x = 1 .
exactSum(ok) :- d(?x), ?x = 0.3 .
