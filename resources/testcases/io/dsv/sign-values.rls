% Regression test for https://github.com/knowsys/nemo/issues/581: the
% cells `+`, `-`, `+.` and `-.` look like the start of a number and
% used to crash the `term` format. They are not terms, so their rows are
% malformed. A `string` column reads them as they are.

@import sign from csv { resource="sources/sign.csv", format=(term,)} .
@import signText from csv { resource="sources/sign.csv", format=(string,)} .
