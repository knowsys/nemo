% Every scalar type has a format of its name, which reads its cells
% strictly: a row whose cell does not read is malformed. Line 3 holds no
% boolean, no date, no number and no language-tagged string. The
% declaration is checked against the formats, and chooses none of them.

@declare reading(flag: bool, day: date, amount: number, greeting: langstring, span: daytimeduration) .
@import reading from csv { resource = "sources/scalars.csv", quoting = false,
    format = (bool, date, number, langstring, daytimeduration) } .

@output reading .
