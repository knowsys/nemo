% Every declarable scalar type has a strict reading: a column declared
% with a type reads its cells in the format of the same name, and a row
% whose cell does not read is malformed. Line 3 holds no boolean, no
% date, no number and no language-tagged string.

@declare reading(flag: bool, day: date, amount: number, greeting: langstring, span: daytimeduration) .
@import reading from csv { resource = "sources/scalars.csv", quoting = false } .

@output reading .
