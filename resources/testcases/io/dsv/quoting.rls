% Quoted fields hold language strings; without quoting, quotes are data.

@import noQuoting from csv{resource="sources/langstrings.csv", quoting=false} .
@import quoting from csv{resource="sources/langstrings.csv"} .

withQuoting(?X, ?Y) :- quoting(?X, ?Y) .
withoutQuoting(?X, ?Y) :- noQuoting(?X, ?Y) .
