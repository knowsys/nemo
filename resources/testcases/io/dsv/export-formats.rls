% Exports to TSV, to CSV, and to DSV with a custom delimiter.

@import sourceA from csv{resource = "sources/dataA.csv"}.
@import sourceB from dsv{resource = "sources/dataB.csv", delimiter = ","}.
@import sourceC from csv{resource = "sources/dataC.csv"}.

@export sourceA to tsv{resource = "sourceA.tsv"}.
@export sourceB to dsv{resource = "sourceB.dsv", delimiter = ";"}.
@export sourceC to csv{resource = "sourceC.csv"}.

@export J1 to tsv{resource = "J1.tsv"}.
@export J2 to dsv{resource = "J2.dsv", delimiter = ";"}.
@export J3 to csv{resource = "J3.csv"}.

J1(?X, ?Y, ?Z) :- sourceA(?X, ?Z, ?Y), sourceB(?X, ?Y, ?T) .
J2(?X, ?Y, ?Z) :- sourceA(?Z, ?Y, ?X), sourceC(?X, ?Y, ?T) .
J3(?X, ?Y, ?W) :- sourceA(?T, ?Y, ?X), sourceB(?T, ?Y, ?X), sourceC(?X, ?Y, ?W) .
