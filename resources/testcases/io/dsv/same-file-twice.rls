% One file imported twice, under two formats.

@import asTerms from csv { resource = "sources/mixed.csv", format = (term, term) } .
@import asStrings from csv { resource = "sources/mixed.csv", format = (string, string) } .

terms(?x, ?y) :- asTerms(?x, ?y) .
strings(?x, ?y) :- asStrings(?x, ?y) .
same(?x) :- asTerms(?x, _), asStrings(?x, _) .
