% The records of a larger document are found by `path`, a JSON Pointer,
% and their keys by `columns`. Each work has a `title`, an array of
% strings, and an `author`, an array of objects, which arrive as a tuple
% of strings and a tuple of maps. A work without an author has a missing
% value, so its row is dropped with a warning.

@import work from json { resource = "sources/works.json",
    path = "/message/items", columns = ("title", "author") } .

first(?name) :- work(?title, ?author), ?name = ?author[0]["family"] .
titled(?name, ?first) :- work(?title, ?author), ?name = ?author[0]["family"], ?first = ?title[0] .

@output first .
