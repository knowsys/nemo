% Three imports and three facts feeding one predicate.

@import source from csv { resource = "sources/dataA.csv" }.
@import source from csv { resource = "sources/dataB.csv" }.
@import source from csv { resource = "sources/dataC.csv" }.

source(A, B, C) .
source(B, C, D) .
source(Q, B, C) .

combined(?X, ?Y, ?Z) :- source(?X, ?Y, ?Z) .

constant(?X) :- combined(?X, B, C) .
constant(?X) :- combined(?X, Y, ?Z) .
